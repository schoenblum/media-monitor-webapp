# Install this file as /etc/media-monitor/backup.env on the production host
# (owned by deploy:deploy, mode 0600). Real values live ONLY on the server —
# never commit a populated copy.
PGPASSWORD=replace-with-real-password

# Optional off-box backup (v2.5). When set, the backup service mirrors
# /var/backups/media_monitor to this rclone remote after each dump, so the
# database survives the loss of the VM/disk. Leave blank/unset to keep
# backups local-only. Configure the remote once with `rclone config` as the
# deploy user (config lands in /home/deploy/.config/rclone/rclone.conf).
# Examples:
#   BACKUP_REMOTE=hetzner-box:media-monitor      # SFTP / Hetzner Storage Box
#   BACKUP_REMOTE=b2:my-bucket/media-monitor     # Backblaze B2 / S3-compatible
# BACKUP_REMOTE=
