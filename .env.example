# Application
SECRET_KEY=generate-with-secrets.token_urlsafe(48)
BASE_URL=https://your-domain.example.com
ENVIRONMENT=production

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/media_monitor

# Encryption key for stored Google API credentials
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=generate-with-fernet

# Email (optional in Phase 1 — leave blank to log reset tokens to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com

# Bootstrap admin (used only if no admin user exists on startup)
BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.com
# Pick any strong throwaway — the bootstrap admin is forced to change it on first login.
BOOTSTRAP_ADMIN_PASSWORD=<set-a-strong-throwaway-here>
